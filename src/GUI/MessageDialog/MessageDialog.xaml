<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  SizeToContent="WidthAndHeight"
  MinWidth="320"
  MaxHeight="720" MaxWidth="1280"
  Padding="0"
  ResizeMode="NoResize">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
      Padding="25,25,25,24"
      Background="{DynamicResource BackgroundElevatedBrush}"
      BorderBrush="{DynamicResource ControlBorderBrush}"
      BorderThickness="0,0,0,1"
      WindowChrome.IsHitTestVisibleInChrome="False">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
          FontFamily="{StaticResource SymbolThemeFontFamily}"
          FontSize="32"
          VerticalAlignment="Top">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,8,16,0" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.Title, Mode=OneTime, TargetNullValue=''}" Value="">
                  <Setter Property="Margin" Value="0,6,16,6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Icon, Mode=OneTime}" Value="Warning">
                  <Setter Property="Text" Value="&#xE7BA;" />
                  <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Icon, Mode=OneTime}" Value="Error">
                  <Setter Property="Text" Value="&#xEA39;" />
                  <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ViewModel.Icon, Mode=OneTime, TargetNullValue=''}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
            Text="{Binding ViewModel.Title, Mode=OneTime}"
            FontSize="20"
            FontWeight="SemiBold"
            TextWrapping="Wrap"
            Margin="0,0,0,12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ViewModel.Title, Mode=OneTime, TargetNullValue=''}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ScrollViewer Grid.Row="1"
            VerticalAlignment="Center"
            VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                <Style.Triggers>
                  <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Collapsed">
                    <Setter Property="Padding" Value="0" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <TextBlock
              Text="{Binding ViewModel.Message, Mode=OneTime}"
              TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18,18,18,19">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button
        Content="{Binding Localization.Ok}"
        Command="{Binding ViewModel.OkCommand}"
        IsDefault="True">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ViewModel.Buttons, Mode=OneTime}" Value="Ok">
                <Setter Property="Grid.Column" Value="2" />
                <Setter Property="Width" Value="130" />
                <Setter Property="HorizontalAlignment" Value="Right" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>

      <Button Grid.Column="2"
        Content="{Binding Localization.Cancel}"
        Command="{Binding ViewModel.CancelCommand}"
        IsCancel="True"
        HorizontalAlignment="Stretch">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ViewModel.Buttons, Mode=OneTime}" Value="Ok">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </Grid>
  </Grid>
</Window>
