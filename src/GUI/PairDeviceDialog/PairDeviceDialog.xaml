<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="350"
  SizeToContent="Height"
  ResizeMode="NoResize"
  FocusManager.FocusedElement="{Binding ElementName=IpAddressBox}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox Grid.Row="0" Name="IpAddressBox"
      Height="32" Width="Auto" />

    <TextBox Grid.Row="2" Name="PairingCodeBox"
      Height="32" Width="Auto" />

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0"
        Content="{Binding Localization.Ok}"
        Command="{Binding ViewModel.OkCommand}"
        IsDefault="True"
        HorizontalAlignment="Stretch" />
      <Button Grid.Column="2"
        Content="{Binding Localization.Cancel}"
        Command="{Binding ViewModel.CancelCommand}"
        IsCancel="True"
        HorizontalAlignment="Stretch" />
    </Grid>
  </Grid>
</Window>
