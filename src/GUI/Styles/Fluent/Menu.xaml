<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Disables WPF's built-in 150ms popup fade so the menu opens at full opacity like WinUI -->
  <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>

  <Style TargetType="ContextMenu">
    <Style.Resources>
      <Storyboard x:Key="RevealStoryboard">
        <DoubleAnimationUsingKeyFrames
          Storyboard.TargetProperty="(Border.LayoutTransform).(ScaleTransform.ScaleY)"
          FillBehavior="Stop">
          <DiscreteDoubleKeyFrame KeyTime="0" Value="0.5" />
          <SplineDoubleKeyFrame KeyTime="0:0:0.25" KeySpline="0,0,0,1" Value="1" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
    </Style.Resources>

    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
    <Setter Property="Background" Value="{DynamicResource OverlayBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
    <Setter Property="Padding" Value="5,4" />
    <Setter Property="MinWidth" Value="120" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Padding="{DynamicResource ContextMenuShadowPadding}">
            <Grid>
              <!-- Reserves full layout height so the popup window never resizes during the animation -->
              <Border
                Visibility="Hidden"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}">
                <Border Height="{Binding ElementName=ItemsHost, Path=ActualHeight}" />
              </Border>

              <Border Name="RevealHost" Visibility="Hidden" VerticalAlignment="Top">
                <Border
                  Name="RevealSizer"
                  Height="{Binding ElementName=ItemsHost, Path=ActualHeight}">
                  <Border.LayoutTransform>
                    <ScaleTransform ScaleY="1" />
                  </Border.LayoutTransform>
                </Border>
              </Border>

              <Border
                Name="MenuRoot"
                VerticalAlignment="Top"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource OverlayCornerRadius}"
                Padding="{TemplateBinding Padding}">
                <Border.Effect>
                  <DropShadowEffect
                    Color="Black"
                    BlurRadius="{DynamicResource ContextMenuShadowBlurRadius}"
                    Direction="270"
                    ShadowDepth="{DynamicResource ContextMenuShadowDepth}"
                    Opacity="{DynamicResource OverlayShadowOpacity}" />
                </Border.Effect>
                <Grid
                  Name="ItemsClip"
                  Height="{Binding ElementName=RevealHost, Path=ActualHeight}"
                  ClipToBounds="True">
                  <StackPanel Name="ItemsHost" IsItemsHost="True">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                        <Style.Triggers>
                          <DataTrigger
                            Binding="{Binding ElementName=MenuRoot, Path=VerticalAlignment}"
                            Value="Bottom">
                            <Setter Property="VerticalAlignment" Value="Top" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="MinHeight" Value="28" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border
            Name="MenuItemBorder"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            Padding="{TemplateBinding Padding}">

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border
                Name="IconBorder"
                Grid.Column="0"
                Width="16"
                Height="16"
                Margin="0,0,8,0">
                <TextBlock
                  Text="{TemplateBinding Icon}"
                  FontFamily="{DynamicResource SymbolThemeFontFamily}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              </Border>

              <ContentPresenter
                Grid.Column="1"
                ContentSource="Header"
                VerticalAlignment="Center" />

              <TextBlock
                Name="InputGestureText"
                Grid.Column="2"
                Margin="38,0,0,0"
                Text="{TemplateBinding InputGestureText}"
                Foreground="{DynamicResource InactiveTextBrush}"
                VerticalAlignment="Center"
                FontSize="12" />
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconBorder" Property="Visibility" Value="Hidden" />
            </Trigger>

            <DataTrigger
              Binding="{Binding RelativeSource={RelativeSource Self}, Path=InputGestureText, TargetNullValue=''}"
              Value="">
              <Setter TargetName="InputGestureText" Property="Visibility" Value="Hidden" />
            </DataTrigger>

            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="MenuItemBorder" Property="Background"
                Value="{DynamicResource ActiveButtonBackgroundBrush}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
              <Setter TargetName="InputGestureText" Property="Foreground"
                Value="{DynamicResource DisabledTextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
