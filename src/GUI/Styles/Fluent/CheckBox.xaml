<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="11,5,11,6" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <BulletDecorator
            Background="Transparent">
            <BulletDecorator.Bullet>
              <Border
                Name="ControlBorderIconPresenter"
                Width="18"
                Height="18"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding Border.CornerRadius}">
                <Border
                  Name="StrokeBorder"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding Border.CornerRadius}">
                  <Grid>
                    <TextBlock
                      Name="ControlIcon"
                      Margin="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="14"
                      FontWeight="Bold"
                      Foreground="{DynamicResource BackgroundBrush}"
                      FontFamily="{DynamicResource SymbolThemeFontFamily}"
                      Visibility="Collapsed"
                      Text="&#xE73E;">
                      <TextBlock.Clip>
                        <RectangleGeometry />
                      </TextBlock.Clip>
                    </TextBlock>
                    <Rectangle
                      Name="IndeterminateBar"
                      Width="8"
                      Height="2"
                      RadiusX="1"
                      RadiusY="1"
                      Fill="{DynamicResource BackgroundBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
                  </Grid>
                </Border>
              </Border>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="8,-1.2,0,0" />
          </BulletDecorator>

          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ControlIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="ControlBorderIconPresenter" Property="Background"
                Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="StrokeBorder" Property="BorderBrush"
                Value="{DynamicResource AccentBrush}" />
              <Trigger.EnterActions>
                <BeginStoryboard Name="RevealStoryboard">
                  <Storyboard>
                    <RectAnimationUsingKeyFrames
                      Storyboard.TargetName="ControlIcon"
                      Storyboard.TargetProperty="Clip.Rect">
                      <DiscreteRectKeyFrame KeyTime="0" Value="0,0,1.4,14" />
                      <SplineRectKeyFrame
                        KeyTime="0:0:0.317"
                        KeySpline="0,0,0,1"
                        Value="0,0,13,14" />
                    </RectAnimationUsingKeyFrames>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <!-- Skips the animation when a checked CheckBox is newly created -->
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <SkipStoryboardToFill BeginStoryboardName="RevealStoryboard" />
            </EventTrigger>
            <!-- Skips the animation when a virtualized container is recycled for an already-selected item -->
            <EventTrigger RoutedEvent="Binding.TargetUpdated">
              <SkipStoryboardToFill BeginStoryboardName="RevealStoryboard" />
            </EventTrigger>

            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
              <Setter TargetName="ControlBorderIconPresenter" Property="Background"
                Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="StrokeBorder" Property="BorderBrush"
                Value="{DynamicResource AccentBrush}" />
            </Trigger>

            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter Property="Background" Value="{DynamicResource ActiveButtonBackgroundBrush}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
