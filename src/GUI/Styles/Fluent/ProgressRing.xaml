<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="ProgressRing" TargetType="Control">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Viewbox Stretch="Fill">
            <Grid Width="32" Height="32">
              <Ellipse
                Stroke="{TemplateBinding Background}"
                StrokeThickness="3" />
              <Path
                Name="Indicator"
                Width="32"
                Height="32"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="3"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform />
                </Path.RenderTransform>
                <Path.Data>
                  <PathGeometry>
                    <PathFigure StartPoint="16,1.5">
                      <ArcSegment Size="14.5,14.5" SweepDirection="Clockwise" />
                    </PathFigure>
                  </PathGeometry>
                </Path.Data>
              </Path>
            </Grid>
          </Viewbox>

          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <PointAnimationUsingPath
                    Storyboard.TargetName="Indicator"
                    Storyboard.TargetProperty="Data.Figures[0].Segments[0].Point"
                    Duration="0:0:1"
                    AutoReverse="True">
                    <PointAnimationUsingPath.PathGeometry>
                      <PathGeometry>
                        <PathFigure StartPoint="16.01,1.5">
                          <ArcSegment Point="16,30.5" Size="14.5,14.5" SweepDirection="Clockwise" />
                        </PathFigure>
                      </PathGeometry>
                    </PointAnimationUsingPath.PathGeometry>
                  </PointAnimationUsingPath>
                  <DoubleAnimationUsingKeyFrames
                    Storyboard.TargetName="Indicator"
                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:1" Value="450" />
                    <LinearDoubleKeyFrame KeyTime="0:0:2" Value="1080" />
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
