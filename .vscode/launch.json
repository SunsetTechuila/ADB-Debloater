{
  "configurations": [
    {
      "name": "Launch Debloater",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/Debloater.ps1 -Dev",
      "createTemporaryIntegratedConsole": true,
    },
    // use to see the error when the script crashes the terminal
    {
      "name": "Launch Debloater - Crash-Safe (PowerShell 7)",
      "type": "PowerShell",
      "request": "launch",
      "script": "pwsh.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}/src/Debloater.ps1\" -Dev",
      "createTemporaryIntegratedConsole": true,
    }
  ]
}
